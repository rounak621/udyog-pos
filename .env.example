# Copy to .env before running `docker compose up`. Compose reads .env from
# this directory automatically — never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:1995
HOST_PORT=1995

# Leave unset/false for the default plain-HTTP setup (LAN IP, localhost, a
# VPS reached over http://). Only set to "true" once this app is actually
# served over HTTPS (a reverse proxy, a Cloudflare Tunnel, etc.) — the
# session cookie is marked Secure when this is true, and browsers silently
# refuse to store a Secure cookie on a plain http:// origin, which locks
# every user out with "Unauthorized" even though login appears to succeed.
# COOKIE_SECURE is off. Use HTTPS and set COOKIE_SECURE=true for internet-facing installs.
COOKIE_SECURE=false

# Optional: makes THIS server a sync hub that Windows/desktop installs can
# two-way sync with (Settings → Server Sync on the other PC). Use a long random
# value (openssl rand -hex 24) and leave unset on installs that are not the hub.
# SYNC_API_KEY=

# Sign-up is open only until the first restaurant exists. Set to true to keep it
# open always (hosted/multi-tenant mode only).
# ALLOW_SIGNUP=true
# Lets prisma/seed.ts load demo data when NODE_ENV=production (install.sh --demo sets it).
# ALLOW_DEMO_SEED=true

# Update check — OFF by default; no network call unless both are set.
# UPDATE_CHECK_ENABLED=true
# GitHub owner/repo whose tags are checked for new versions.
# UPDATE_REPO=owner/repo
# Optional GHCR image (owner/image) used to confirm a release's image is published.
# UPDATE_IMAGE_REPO=owner/image
# Updater sidecar: image repo per container, comma-separated container=registry/owner/image.
# UPDATER_IMAGE_REPOS=nodedr-restaurant-backend=ghcr.io/owner/backend,nodedr-restaurant-web=ghcr.io/owner/web
# Base repo URL for the download links page; empty = no download links.
# DOWNLOADS_BASE_URL=https://github.com/owner/repo

# Support email for the "Help & support" item in the user menu; unset = item hidden. Read when the web app is built.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
