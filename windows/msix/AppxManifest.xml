<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Package identity is a TEMPLATE. build-windows-msix.ps1 replaces the
    __TOKENS__ below from its -IdentityName / -Publisher /
    -PublisherDisplayName / -Version parameters (defaults are a fake DEV
    identity). For a real release the owner supplies either the Partner
    Center "Product identity" values or the Subject of their own
    code-signing certificate; see windows/README.md.
  -->
  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>UDYOG POS</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!--
    TargetDeviceFamily: Windows.Desktop only, minimum build reflects the
    WebView2 Runtime's real support floor (Windows 10 1809+ / Server 2019+).
  -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Applications>
    <Application Id="UDYOGPOS" Executable="UDYOGPOS.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="UDYOG POS"
        Description="Restaurant billing and ordering."
        BackgroundColor="#1A1A1A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1A1A1A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!--
    Capabilities: deliberately minimal, per hardening brief sections 2/17/26.

    - internetClient: outbound HTTPS to the UDYOG POS cloud server. This is the ONLY capability the app needs.
    - runFullTrust: required for any Win32/.NET desktop app packaged as
      MSIX (this is what "EntryPoint=Windows.FullTrustApplication" above
      declares) — this is NOT the same thing as elevation/admin rights.
      It does not request UAC, does not grant broad filesystem/registry
      access, and is unrelated to the "restricted capabilities" the brief
      warns against (those are things like broadFileSystemAccess,
      documentsLibrary, or device-class capabilities — none of which are
      declared here).

    Explicitly NOT requested, on purpose: usb/serial/bluetooth device
    capabilities, broadFileSystemAccess, microphone, webcam, location,
    or any restricted capability. If Windows printer access ever required
    a capability at all (it does not — printing through an installed
    Windows printer driver via the OS print dialog needs zero MSIX
    capability declarations), it would be added here explicitly and
    justified, not assumed.
  -->
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
