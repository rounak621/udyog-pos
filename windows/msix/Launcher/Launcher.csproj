<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal WebView2 shell for the UDYOG POS Windows client.

    This is NOT Electron: it ships no bundled Chromium. It hosts the
    OS-shared, evergreen WebView2 Runtime (present on Windows 11 and
    auto-installed on Windows 10 by the WebView2 Bootstrapper if missing) —
    the same runtime every Edge-based system webview uses.

    Packaged as a plain self-contained WinForms publish, then wrapped into
    an MSIX by ../build-windows-msix.ps1 via a manual `dotnet publish` +
    stage + `makeappx pack` flow (not MSBuild's single-project-MSIX
    tooling) — see that script for why: it's the more predictable, more
    widely documented path for a WinForms/WPF ("Desktop Bridge") app, and
    doesn't depend on MSBuild msix-packaging targets being present in every
    build environment.

    Runs as a normal desktop app: no elevation (see app.manifest,
    requestedExecutionLevel="asInvoker"), no console window
    (OutputType=WinExe), no admin/service/driver requirements. The MSIX
    manifest (../AppxManifest.xml) declares runFullTrust — required for
    ANY Win32-model desktop app (WinForms/WPF/WinUI3 alike) packaged via
    Desktop Bridge; this is a "not AppContainer-sandboxed" flag, not an
    elevation/admin request. See that file's own comment for the full
    reasoning against the hardening brief's "no unnecessary restricted
    capabilities" rule.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.17763 (Windows 10 1809, the MSIX MinVersion) for the WinRT
         StartupTask API used by AutoStart.cs. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UdyogPos.Shell</RootNamespace>
    <AssemblyName>UDYOGPOS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>

    <!-- Self-contained win-x64 folder publish — no separate .NET runtime
         install required on the target machine, and no "install .NET
         first" step for the user (see build-windows-msix.ps1).

         Deliberately NOT PublishSingleFile: WebView2's SDK does its own
         LoadLibrary("WebView2Loader.dll") lookup next to the exe, which
         bypasses .NET's single-file native-asset extraction — combining
         WebView2 with PublishSingleFile is a known incompatibility
         (WebView2Loader.dll ends up embedded in the exe instead of
         present as a loose file, so CoreWebView2Environment creation
         fails at runtime). MSIX already packages the whole output
         folder into one .msix container, so single-file packaging
         wasn't buying anything here anyway. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Overridden by build-windows-msix.ps1 (-p:Version=...). -->
    <Version>0.1.0.0</Version>
    <Product>UDYOG POS</Product>
    <Company>UDYOG</Company>
    <Copyright>Copyright © Nodedr Infotech Private Limited</Copyright>
  </PropertyGroup>

  <!-- Optional pre-fill for the first-run server form:
       dotnet publish -p:DefaultServerUrl=https://pos.example.com
       Read at runtime by AppConfig.BuildDefaultServerUrl. Empty = blank form. -->
  <PropertyGroup>
    <DefaultServerUrl Condition="'$(DefaultServerUrl)' == ''"></DefaultServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DefaultServerUrl" Value="$(DefaultServerUrl)" />
    <EmbeddedResource Include="Resources\offline.html" LogicalName="offline.html" />
    <EmbeddedResource Include="Resources\logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

</Project>
