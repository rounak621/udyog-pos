# UDYOG POS - production/staging settings, read by docker-compose.prod.yml.
# Copy to .env.production ON THE SERVER only, fill in, `chmod 600`.
# Never commit .env.production. Every value below is a placeholder.
# Generate a secret: openssl rand -hex 32

# ---------------------------------------------------------------- Required secrets
# Signs login sessions. At least 32 random characters.
JWT_SECRET=CHANGE_ME
# Encrypts two-factor secrets at rest (falls back to JWT_SECRET if empty; set it).
TWO_FACTOR_KEY=CHANGE_ME
# Encrypts webhook signing secrets at rest (falls back to JWT_SECRET if empty; set it).
WEBHOOK_KEY=CHANGE_ME
# Spain VERI*FACTU only: encrypts certificates at rest (falls back to JWT_SECRET). Leave empty in India.
VERIFACTU_KEY=

# ---------------------------------------------------------------- Database
# Managed Postgres: full URL. Bundled Postgres (profile localdb): host "postgres".
DATABASE_URL=postgresql://udyog:CHANGE_ME@postgres:5432/udyog
# Only with the bundled database: start it with the app.
COMPOSE_PROFILES=localdb
# Bundled database user/password/name (must match DATABASE_URL above).
POSTGRES_USER=udyog
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=udyog

# ---------------------------------------------------------------- Domain and cookies
# Public domain served by Caddy (DNS A record -> this server).
DOMAIN=app.example.com
# Allowed browser origin for the API and Socket.IO (https + the domain above).
CORS_ORIGIN=https://app.example.com
# Session cookie only over HTTPS.
COOKIE_SECURE=true
# One reverse proxy (Caddy) in front: trust one hop for client IPs / rate limits.
TRUST_PROXY=1
# Session lifetime.
JWT_EXPIRES_IN=12h
# API reference at /api/docs; keep off in production.
ENABLE_SWAGGER=false

# ---------------------------------------------------------------- Images (set by scripts/deploy.sh)
# Image names without tag; TAG is passed by scripts/deploy.sh.
BACKEND_IMAGE=ghcr.io/rounak621/udyog-pos-backend
WEB_IMAGE=ghcr.io/rounak621/udyog-pos-web

# ---------------------------------------------------------------- Hosted mode
# true = anyone can sign up a new restaurant (starts a trial).
ALLOW_SIGNUP=false
# Trial length in days for new sign-ups.
TRIAL_DAYS=14

# ---------------------------------------------------------------- Billing (Razorpay subscriptions)
# Empty = online payment off. Webhook URL: https://<domain>/api/v1/billing/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Days a lapsed subscription keeps working.
GRACE_DAYS=3

# ---------------------------------------------------------------- Company / GST (UDYOG's own invoices)
# Missing values = no subscription invoice is issued ("Invoice pending").
COMPANY_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
# SAC code and GST rate for subscription invoices (confirm with a CA).
SUBSCRIPTION_SAC=
GST_RATE_PERCENT=

# ---------------------------------------------------------------- Backups (S3-compatible)
# Can also be set in the app (platform admin). Empty = env backups off.
S3_BACKUP_ENDPOINT=
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_REGION=ap-south-1
# Days between automatic backups and how many to keep.
S3_BACKUP_INTERVAL_DAYS=1
S3_BACKUP_RETAIN_COUNT=14

# ---------------------------------------------------------------- Email
# SMTP connection URL, e.g. smtps://user:CHANGE_ME@smtp.example.com:465. Empty = no email.
SMTP_URL=
# Sender address for emails.
SMTP_FROM=

# ---------------------------------------------------------------- Printing / Windows app
# Server prints over USB/9100 itself. Never in the cloud: leave false.
ALLOW_SERVER_PRINT=false
# Oldest supported UDYOG POS Windows app version (empty = no update banner).
MIN_SHELL_VERSION=

# ---------------------------------------------------------------- Off in the cloud
# Self-host update checks and server-to-server sync: leave empty.
UPDATE_CHECK_ENABLED=
SYNC_API_KEY=
# Never set WEBHOOKS_ALLOW_PRIVATE or WEBHOOKS_ALLOW_INSECURE in production
# (docker-compose.prod.yml forces them empty).
